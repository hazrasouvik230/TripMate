# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tripmate-ai

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------
# LLM provider (Google Gemini) — SERVER-SIDE ONLY, never sent to the client
# ----------------------------------------------------------------------
# Required to enable AI features. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model + generation parameters (all optional; sensible defaults applied)
# gemini-flash-lite-latest = fast, cheap, always-current (recommended for a mini project).
# Heavier models (e.g. gemini-3.8-flash) are slower and more easily throttled on the free tier.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
# Thinking level (Gemini 3.x): MINIMAL | LOW | MEDIUM | HIGH (lower = faster/cheaper)
GEMINI_THINKING_LEVEL=LOW

# Transport resilience
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

# Request limits (guard rails)
LLM_MAX_INPUT_CHARS=8000
LLM_MAX_OUTPUT_TOKENS_CAP=4096
LLM_RATE_WINDOW_MS=60000
LLM_RATE_MAX=10

# Embeddings — configurable model + output dimensions (uses GEMINI_API_KEY)
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768            # gemini-embedding-001 supports 128–3072
GEMINI_EMBED_BATCH=100          # max texts per batch request
GEMINI_EMBED_TASK=RETRIEVAL_DOCUMENT  # RETRIEVAL_DOCUMENT for ingest, RETRIEVAL_QUERY for queries

# Document chunking (characters)
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Atlas Vector Search
ATLAS_VECTOR_INDEX=travel_vector_index
SEARCH_LIMIT=5                 # default results per query
SEARCH_MAX_LIMIT=20
SEARCH_CANDIDATES_FACTOR=15    # numCandidates = limit * factor (recall vs cost)

# Retrieval-Augmented Generation (POST /api/v1/ai/ask)
RAG_LIMIT=5                    # chunks retrieved per question
RAG_MIN_SCORE=0.78             # drop chunks below this cosine score (else "insufficient evidence")
RAG_MAX_CONTEXT_CHARS=6000     # cap assembled context size

# ----------------------------------------------------------------------
# External providers — places / routing / weather (SERVER-SIDE ONLY)
# Defaults are keyless, terms-friendly services; swap for keyed providers by
# changing the *_PROVIDER + base URL (+ key) here.
# ----------------------------------------------------------------------
# Identify your app per Nominatim's usage policy (a real contact in production).
GEO_USER_AGENT=TripMateAI/1.0 (tripmate-ai app)

PLACES_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
PLACES_API_KEY=
PLACES_MIN_INTERVAL_MS=1100    # Nominatim asks for <= 1 request/second

ROUTE_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
ROUTE_API_KEY=

WEATHER_PROVIDER=open-meteo
OPEN_METEO_URL=https://api.open-meteo.com
WEATHER_API_KEY=

# Currency exchange rates (optional budget display conversion)
FX_PROVIDER=frankfurter
FX_URL=https://api.frankfurter.app
FX_API_KEY=
FX_CACHE_TTL_MS=3600000        # 1 hour

GEO_TIMEOUT_MS=12000
GEO_CACHE_TTL_MS=600000        # ephemeral cache only (provider data not persisted)
GEO_RATE_WINDOW_MS=60000
GEO_RATE_MAX=30

# ----------------------------------------------------------------------
# MCP server (optional; `npm run mcp`) — identifies the single acting user.
# Provide ONE of these; private trip tools are scoped to this user only.
# (Public tools work without any of them.) Reuses JWT_SECRET above.
# ----------------------------------------------------------------------
TRIPMATE_JWT=
TRIPMATE_EMAIL=
TRIPMATE_PASSWORD=
